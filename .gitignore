# vendored third-party MCP server source (github.com/ahujasid/blender-mcp) -
# fetched by us, not ours to commit; see blender/README.md for how to get it
blender/_blender_mcp_src/
blender/_py_deps/

# training outputs: resumable checkpoints (.ckpt, includes optimizer state)
# and logs are reproducible from the scripts and too large for git; the
# final deployable weights (checkpoint_best_*.pth) are tracked via Git LFS -
# see training/README.md to regenerate everything else
training/output/*
!training/output/checkpoint_best_ema.pth
!training/output/checkpoint_best_regular.pth
!training/output/checkpoint_best_total.pth

training/output_crane/*
!training/output_crane/checkpoint_best_ema.pth
!training/output_crane/checkpoint_best_regular.pth
!training/output_crane/checkpoint_best_total.pth

training/output_crane_hook3d/*
!training/output_crane_hook3d/checkpoint_best_ema.pth
!training/output_crane_hook3d/checkpoint_best_regular.pth
!training/output_crane_hook3d/checkpoint_best_total.pth

training/output_crane_hook3d_v2/*
!training/output_crane_hook3d_v2/checkpoint_best_ema.pth
!training/output_crane_hook3d_v2/checkpoint_best_regular.pth
!training/output_crane_hook3d_v2/checkpoint_best_total.pth

training/*.log

