# Copy to backend/.env and fill in. Loaded by backend/app/config.py.
# A real environment variable of the same name always overrides these.

# Plant camera credentials (Hikvision). The password may contain "@" / ":" -
# it is URL-encoded when the RTSP URL is built in camera_feed.py.
CAM_USER=
CAM_PASS=

# Optional overrides (defaults live in config.py):
# CAMERAS_ENABLED=1
# CAM101_HOST=192.168.1.101
# CAM102_HOST=192.168.1.102
# CAM_RTSP_PATH=/Streaming/Channels/101   # Hikvision ch1 main stream
# CAM_RTSP_PORT=554
